{
  "name": "My Project with Postgres and Rust",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/itsmechlark/features/postgresql": {
      "version": "17",
      "password": "postgres"
    },
    "ghcr.io/rails/devcontainer/features/postgres-client:1": {

    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-db.sh",
  "forwardPorts": [5432]
}