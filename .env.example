RUST_LOG="info,http_stuff::http_request_parsing=info,server=info,routing::router=info"
RUST_LOG_DIRECTORY_PATH="/home/user1/manual_server_2_logs"

# toggling this disables the turnstile captcha thingie
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=3x00000000000000000000FF


# depends on upstream
USING_HTTPS=true

IP=127.0.0.1
PORT=4444

# Depending on if I wanna use ssl for db connection

# non-tls
DATABASE_URL=postgres://user123:password123@localhost:5432/database123

# tls
# DATABASE_URL=postgres://user123:password123@localhost:5432/database123?sslmode=verify-full&sslrootcert=local_ssl/postgres.crt


PER_IP_TIME_CREDITS_CAPACITY_MILLIS=5000
PER_IP_TIME_CREDITS_REFILL_RATE_MILLIS_PER_MILLIS=10

SERVER_TIME_CREDITS_CAPACITY_MILLIS=50000
SERVER_TIME_CREDITS_REFILL_RATE_MILLIS_PER_MILLIS=100

SERVER_TOKEN_BUCKET_CAPACITY=1000.0
SERVER_TOKEN_BUCKET_REFILL_RATE_PER_MILLIS=0.010

PER_IP_TOKEN_BUCKET_CAPACITY=100.0
PER_IP_TOKEN_BUCKET_REFILL_RATE_PER_MILLIS=0.100

# setting this to false will send close on every request and close immediately
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_MAX_REQUESTS_PER_CONNECTION=10
KEEP_ALIVE_IDLE_TIMEOUT_MILLIS=5000

COMMON_STREAM_TIMEOUT_MILLIS=2000

MAX_TOTAL_HEADERS_SIZE_BYTES=8192
MAX_HEADERS_COUNT=50
MAX_HEADER_NAME_LENGTH= 100
MAX_HEADER_VALUE_LENGTH= 2048
MAX_TOTAL_BODY_SIZE_BYTES= 10485760
MAX_REQUEST_PATH_LENGTH= 150
MAX_COOKIES_COUNT= 50



PASSWORD_HASHER_CONFIG[m_cost_kib] = 16000 
PASSWORD_HASHER_CONFIG[t_cost] = 2 
PASSWORD_HASHER_CONFIG[p_cost] = 2 

