# depends on downstream. Alternatives: make downstream pass X-Forwarded-Proto or just always use https (since I am not really planning on using plain http anyway... Even during testing it is not that tedious to self-generate and import own CA in browsers/mobiles)
USING_HTTPS=true
IP=127.0.0.1
PORT=4444
STATIC_RESOURCES_FOLDER=/workspaces/manual_server_2/static_resources
RUST_LOG_DIRECTORY_PATH=/workspaces/manual_server_2_logs
RUST_LOG="debug"


EMAIL_OTP_FROM_ADDRESS="email_verification@example.com"
EMAIL_OTP_FROM_NAME="God" 
RESEND_API_KEY=re_...
AHASEND_API_KEY=aha-...
AHASEND_ACCOUNT_ID=...
LETTERMINT_PROJECT_TOKEN=lm_...

PASSWORD_HASHER_CONFIG.MEMORY_COST_KIB = 16000 
PASSWORD_HASHER_CONFIG.TIME_COST = 2 
PASSWORD_HASHER_CONFIG.PARALLELISM_COST = 2 

MIN_LENGTH_FORUM_THREAD_NAME = 3
MAX_LENGTH_FORUM_THREAD_NAME = 222

MIN_LENGTH_FORUM_MESSAGE = 3
MAX_LENGTH_FORUM_MESSAGE = 10000



MIN_LENGTH_USER_PASSWORD = 11
MAX_LENGTH_USER_PASSWORD = 333


# Depending on if I wanna use ssl for db connection

# non-tls
DATABASE_URL=postgres://userms2:passwordms2@localhost:5432/databasems2

# tls
# DATABASE_URL=postgres://userms2:passwordms2@localhost:5432/databasems2?sslmode=verify-full&sslrootcert=local_ssl/postgres.crt


# toggling this disables the turnstile captcha thingie
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=3x00000000000000000000FF
CLOUDFLARE_TURNSTILE_POST_PARAMETER_NAME="cf-turnstile-response"


WEBHOOK_AND_API_SECRET_PATH_PREFIX="secret123"
PAYMENT_SERVER_URL="http://localhost:6677"
PAYMENT_SERVER_CLOUDFLARE_BYPASS_UNDER_ATTACK_CHECK_HEADER_NAME="header_name"
PAYMENT_SERVER_CLOUDFLARE_BYPASS_UNDER_ATTACK_CHECK_HEADER_TOKEN_VALUE="secret_header_value"
